@model Warehouse_25dh110314.Models.Product

@{
    ViewBag.Title = "Thêm sản phẩm mới";
}

<div class="card shadow-sm col-md-8 mx-auto">
    <div class="card-header bg-white py-3">
        <h5 class="m-0 text-primary fw-bold">Câu 6: Thêm sản phẩm mới vào kho</h5>
    </div>
    <div class="card-body">
        @using (Html.BeginForm("Create", "Products", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-bold">Tên sản phẩm:</label>
                @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control", placeholder = "Nhập tên sản phẩm..." })
                @Html.ValidationMessageFor(m => m.ProductName, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Danh mục:</label>
                @Html.TextBoxFor(m => m.Category, new { @class = "form-control", placeholder = "Nhập danh mục..." })
                @Html.ValidationMessageFor(m => m.Category, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Đơn giá (VNĐ):</label>
                @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", step = "any", placeholder = "Nhập đơn giá (> 0)..." })
                @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Số lượng tồn kho:</label>
                @Html.TextBoxFor(m => m.Quantity, new { @class = "form-control", type = "number", placeholder = "Nhập số lượng (>= 0)..." })
                @Html.ValidationMessageFor(m => m.Quantity, "", new { @class = "text-danger" })
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary px-4">Thêm mới</button>
                <a href="@Url.Action("Index", "Products")" class="btn btn-secondary">Quay lại danh sách</a>
            </div>
        }
    </div>
</div>