@model IEnumerable<Warehouse_25dh110314.Models.Product>

@{
    ViewBag.Title = "Thống kê kho hàng";
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white shadow-sm">
            <div class="card-body py-4 text-center">
                <h6 class="text-uppercase fw-bold">Tổng số sản phẩm</h6>
                <h2 class="display-5 fw-bold my-2">@ViewBag.TotalProducts</h2>
                <small>Bản ghi trong CSDL</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-danger text-white shadow-sm">
            <div class="card-body py-4 text-center">
                <h6 class="text-uppercase fw-bold">Sản phẩm giá cao (>= 500.000đ)</h6>
                <h2 class="display-5 fw-bold my-2">@ViewBag.HighPriceProductsCount</h2>
                <small>Sản phẩm mức Giá cao</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white shadow-sm">
            <div class="card-body py-4 text-center">
                <h6 class="text-uppercase fw-bold">Tổng giá trị tồn kho</h6>
                <h2 class="display-5 fw-bold my-2">@ViewBag.TotalInventoryValue.ToString("N0") đ</h2>
                <small>Tổng (Đơn giá × Số lượng)</small>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <h6 class="m-0 text-primary fw-bold">Bảng chi tiết giá trị từng sản phẩm</h6>
    </div>
    <div class="card-body p-0">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ProductID</th>
                    <th>Tên sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Đơn giá</th>
                    <th>Số lượng tồn</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    decimal subTotal = item.Price * item.Quantity;
                    <tr>
                        <td>@item.ProductID</td>
                        <td>@item.ProductName</td>
                        <td>@item.Category</td>
                        <td>@item.Price.ToString("N0") đ</td>
                        <td>@item.Quantity</td>
                        <td class="fw-bold text-end">@subTotal.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>